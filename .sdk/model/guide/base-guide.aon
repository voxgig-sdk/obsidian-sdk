      op: patch: transform: req: "target": *("`reqdata.target`")|top
      op: patch: transform: req: "targetType": *("`reqdata.target_type`")|top
      op: patch: transform: req: "value": *("`reqdata.value`")|top
      op: patch: transform: req: "within": *("`reqdata.within`")|top
      op: remove: method: *DELETE
      op: update: method: *PUT
    }
  }

  entity: command: {
    path: "/commands/": {
      op: list: method: *GET
      op: list: transform: res: *("`body.commands`")|top
    }
    path: "/commands/{commandId}/": {
      rename: param: "commandId": *"id"
      op: create: method: *POST
    }
  }

  entity: entity1: {
