# Guide

guide: {
  metrics: count: entity: 2
  metrics: count: path: 4
  metrics: count: method: 8

  entity: tag: {
    path: "/tags/": {
      op: list: method: *GET
      op: list: transform: res: *("`body.tags`")|top
    }
  }

  entity: vault: {
    path: "/vault/": {
      op: list: method: *GET
      op: list: transform: res: *("`body.files`")|top
    }
    path: "/vault/{filename}": {
      rename: param: "filename": *"id"
      op: create: method: *POST
      op: load: method: *GET
      op: patch: method: *PATCH
      op: patch: transform: req: "content": *("`reqdata.content`")|top
      op: patch: transform: req: "createTargetIfMissing": *("`reqdata.create_target_if_missing`")|top
      op: patch: transform: req: "destination": *("`reqdata.destination`")|top
      op: patch: transform: req: "ifMatch": *("`reqdata.if_match`")|top
      op: patch: transform: req: "operation": *("`reqdata.operation`")|top
      op: patch: transform: req: "rejectIfContentPreexists": *("`reqdata.reject_if_content_preexist`")|top
      op: patch: transform: req: "scope": *("`reqdata.scope`")|top
      op: patch: transform: req: "target": *("`reqdata.target`")|top
      op: patch: transform: req: "targetType": *("`reqdata.target_type`")|top
      op: patch: transform: req: "value": *("`reqdata.value`")|top
      op: patch: transform: req: "within": *("`reqdata.within`")|top
      op: remove: method: *DELETE
      op: update: method: *PUT
    }
    path: "/vault/{pathToDirectory}/": {
      rename: param: "pathToDirectory": *"id"
      op: load: method: *GET
    }
  }

}