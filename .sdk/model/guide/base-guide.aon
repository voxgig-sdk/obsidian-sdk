      op: patch: transform: req: "createTargetIfMissing": *("`reqdata.create_target_if_missing`")|top
      op: patch: transform: req: "destination": *("`reqdata.destination`")|top
      op: patch: transform: req: "ifMatch": *("`reqdata.if_match`")|top
      op: patch: transform: req: "operation": *("`reqdata.operation`")|top
      op: patch: transform: req: "rejectIfContentPreexists": *("`reqdata.reject_if_content_preexist`")|top
      op: patch: transform: req: "scope": *("`reqdata.scope`")|top
