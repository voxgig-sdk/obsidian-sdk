  }

  entity: vault: {
    path: "/vault/": {
      op: list: method: *GET
      op: list: transform: res: *("`body.files`")|top
    }
    path: "/vault/{filename}": {
      rename: param: "filename": *"id"
      op: create: method: *POST
      op: load: method: *GET
