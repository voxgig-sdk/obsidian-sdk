# Entity: active

main: kit: entity: active: {

  alias: field: {}

  fields: {
    content: {
      h: "Content"
      n: "content"
      r: false
      sh: "String payload: a heading/block body or label, a new block id for a block `marker` rename (letters, numbers, hyphens, and underscores only), or a new frontmatter key name for a frontmatter `marker` rename."
      t: "`$STRING`"
    }
    createTargetIfMissing: {
      h: "Create Target If Missing"
      n: "createTargetIfMissing"
      r: false
      sh: "Create the target (heading path, block id, or frontmatter key) if it does not already exist."
      t: "`$BOOLEAN`"
    }
    destination: {
      h: "Destination"
      n: "destination"
      r: true
      sh: "For a heading move (operation `replace`, scope `parent`): where the section is re-parented."
      t: "`$OBJECT`"
      union: {
        branches: 3
        count: 1
        depth: 2
      }
    }
    ifMatch: {
      h: "If Match"
      n: "ifMatch"
      r: false
      sh: "Optimistic-concurrency token (the `version` from a prior document map)."
      t: "`$STRING`"
    }
    operation: {
      h: "Operation"
      n: "operation"
      r: true
      sh: "What happens to the scoped span: replace it, insert before (`prepend`) or after (`append`), or `delete` it."
      t: "`$STRING`"
    }
    rejectIfContentPreexists: {
      h: "Reject If Content Preexists"
      n: "rejectIfContentPreexists"
      r: false
      sh: "Fail a `prepend`/`append` when the string content already appears in the target span (makes those operations idempotent on retry)."
      t: "`$BOOLEAN`"
    }
    scope: {
      h: "Scope"
      n: "scope"
      r: false
      sh: "Which part of the target the operation acts on (default `content`)."
      t: "`$STRING`"
    }
    target: {
      h: "Target"
      n: "target"
      r: true
      sh: "The node to edit."
      t: "`$ANY`"
      union: {
        branches: 2
        count: 1
        depth: 0
      }
    }
    targetType: {
      h: "Target Type"
      n: "targetType"
      r: true
      sh: "The kind of node to edit."
      t: "`$STRING`"
    }
    value: {
      h: "Value"
      n: "value"
      r: false
      sh: "Structured JSON payload: a frontmatter value (any JSON — string, number, boolean, array, object, null; for `prepend`/`append` this merges: list concat, dict merge, string concat), or table rows on a `block` target's `content` cell (a 2-D a…"
      t: "`$ANY`"
    }
    within: {
      h: "Within"
      n: "within"
      r: false
      sh: "Refines a heading target to one of the section's direct-body top-level blocks (a paragraph, list, table, code fence, blockquote, …): 0 is the first block in document order, and a negative index counts from the end (-1 = last)."
      t: "`$INTEGER`"
    }
  }

