# Entity: open

main: kit: entity: open: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "open"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "filename"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "new_leaf"
                orig: "new_leaf"
                reqd: false
                type: "`$BOOLEAN`"
              }
            ]
          }
          contract: {
            id: "POST /open/{filename}"
            json: "{\"parameters\":[{\"description\":\"Path to the file to return (relative to your vault root).\\n\",\"in\":\"path\",\"name\":\"filename\",\"required\":true,\"schema\":{\"format\":\"path\",\"type\":\"string\"}},{\"description\":\"Open this as a new leaf?\",\"in\":\"query\",\"name\":\"newLeaf\",\"required\":false,\"schema\":{\"type\":\"boolean\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"description\":\"Success\"}},\"security\":[{\"apiKeyAuth\":[]}],\"securitySchemes\":{\"apiKeyAuth\":{\"description\":\"Find your API Key in your Obsidian settings\\nin the \\\"Local REST API\\\" section under \\\"Plugins\\\".\\n\",\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"definition\"}"
            source: "openapi3"
            version: 1
          }
          method: "POST"
          orig: "/open/{filename}"
          rename: {
            param: {
              filename: "id"
            }
          }
          segments: [
            {
              lit: "open"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "new_leaf"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
